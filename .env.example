# Generate with: npm run secret   (32 random bytes, hex = 64 chars)
MCP_SECRET=
# path (default; MCP served at /mcp/<secret>) or header (x-api-key on /mcp). Only one is ever enabled.
AUTH_MODE=path
PORT=3000
NODE_ENV=production

# Local runs only: Railway never reads this file. On Railway, set each variable on the app service
# (docs/setup-guide.md, Part B), with DATABASE_URL='${{Postgres.DATABASE_URL}}' (the private URL).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prioritizer

# The single POC user (seeded idempotently on startup)
POC_USER_EMAIL=jeevan@example.com
POC_USER_NAME=Jeevan
USER_TIMEZONE=Asia/Kolkata

# Backfill size: 30/7 for Jeevan; 2/1 on Nimesh's dry-run deployment
BACKFILL_DAYS=30
SLICE_DAYS=7
